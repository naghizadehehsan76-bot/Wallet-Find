generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  ADVERTISER
}

enum ContestStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  FINISHED
  CANCELLED
}

enum ClueType {
  TEXT
  IMAGE
  PDF
  AUDIO
  VIDEO
  WEB_PAGE
}

enum ClueSource {
  SYSTEM
  ADVERTISER
}

enum AdvertiserContentType {
  TEXT
  LINK
  FILE
  IMAGE
  PDF
  AUDIO
  VIDEO
}

enum ContentProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum AdvertisementStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AdvertisementMetricType {
  VIEW
  CLICK
  PARTICIPATION
}

enum ExternalVisitVerificationStatus {
  NOT_CONFIGURED
  PENDING
  CONFIRMED
  REJECTED
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  username     String @unique
  passwordHash String
  emailVerifiedAt DateTime? @default(now())
  avatarDataUrl String? @db.Text

  role UserRole @default(USER)

  submissions         Submission[]
  advertiserContent   AdvertiserContent[]
  advertisementOrders AdvertisementOrder[]
  auditLogs           AuditLog[]
  walletTransactions  WalletTransaction[]
  walletAccount       WalletAccount?
  walletDeposits      WalletDeposit[]
  walletWithdrawals   WalletWithdrawal[]
  walletChainDeposits WalletChainDeposit[]
  walletChainWithdrawals WalletChainWithdrawal[]
  walletJournals WalletJournal[]
  walletProvisioningIntent WalletProvisioningIntent?
  contestSourceVisits ContestSourceVisit[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime?

  @@index([role])
  @@index([lastSeenAt])
  @@map("users")
}

model Contest {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      ContestStatus @default(DRAFT)
  language    String        @default("en")

  startsAt DateTime?
  endsAt   DateTime?

  clues       ContestClue[]
  submissions Submission[]
  sourceVisits ContestSourceVisit[]

  setting ContestSetting?

  advertisementOrders AdvertisementOrder[]
  prizePool PrizePool?
  prizeLedger PrizeLedger[]
  prizeAwards PrizeAward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startsAt])
  @@index([language, status, startsAt])
  @@map("contests")
}

model AdvertiserContent {
  id String @id @default(cuid())

  advertiserId String

  type AdvertiserContentType

  title       String?
  description String?

  url      String?
  fileName String?
  filePath String?
  mimeType String?

  textContent String?

  processingStatus ContentProcessingStatus @default(PENDING)
  processingError  String?

  processedAt DateTime?

  advertiser User @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  clues ContestClue[]
  sourceVisits ContestSourceVisit[]

  advertisementOrders AdvertisementOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advertiserId])
  @@index([processingStatus])
  @@map("advertiser_contents")
}

model ContestClue {
  id        String @id @default(cuid())
  contestId String
  sequence  Int

  type   ClueType   @default(TEXT)
  source ClueSource @default(SYSTEM)

  content String

  correctAnswer String

  sourceUrl   String?
  hintAnchor  String?
  options     Json?

  advertiserContentId String?

  publishedAt DateTime?

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  advertiserContent AdvertiserContent? @relation(fields: [advertiserContentId], references: [id], onDelete: SetNull)

  submissions Submission[]
  sourceVisits ContestSourceVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contestId, sequence])
  @@index([contestId])
  @@index([publishedAt])
  @@index([source])
  @@index([advertiserContentId])
  @@map("contest_clues")
}

model Submission {
  id String @id @default(cuid())

  userId    String
  contestId String
  clueId    String

  answer    String
  isCorrect Boolean @default(false)

  submittedAt    DateTime @default(now())
  responseTimeMs BigInt?

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest Contest     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  clue    ContestClue @relation(fields: [clueId], references: [id], onDelete: Cascade)

  @@index([userId, contestId])
  @@index([contestId, clueId])
  @@index([contestId, userId])
  @@map("submissions")
}

model SystemSetting {
  key String @id

  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model ContestSetting {
  id String @id @default(cuid())

  contestId String @unique

  clueCount Int @default(12)

  publishIntervalMinutes Int @default(2)

  firstPrizePercent  Int @default(50)
  secondPrizePercent Int @default(20)
  thirdPrizePercent  Int @default(10)

  maxParticipants Int?

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contest_settings")
}

model AuditLog {
  id String @id @default(cuid())

  userId String?

  action String

  entity   String
  entityId String?

  metadata Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@map("audit_logs")
}

model AdvertisementOrder {
  id String @id @default(cuid())

  advertiserId String
  contentId    String

  contestId String?

  status AdvertisementStatus @default(DRAFT)

  basePrice        Int
  participantPrice Int @default(0)
  viewPrice        Int @default(0)

  totalPrice Int

  targetParticipants Int?
  targetViews        Int?

  startsAt DateTime?
  endsAt   DateTime?

  paidAt DateTime?

  advertiser User              @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  content    AdvertiserContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contest    Contest?          @relation(fields: [contestId], references: [id], onDelete: SetNull)

  payments AdvertisementPayment[]
  metrics  AdvertisementMetric[]
  sourceVisits ContestSourceVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advertiserId])
  @@index([contentId])
  @@index([contestId])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@map("advertisement_orders")
}

model AdvertisementPayment {
  id String @id @default(cuid())

  advertisementOrderId String

  amount Int

  status PaymentStatus @default(PENDING)

  provider      String?
  transactionId String?

  paidAt DateTime?

  advertisementOrder AdvertisementOrder @relation(fields: [advertisementOrderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advertisementOrderId])
  @@index([status])
  @@index([transactionId])
  @@map("advertisement_payments")
}

model AdvertisementPricing {
  id String @id @default(cuid())

  name String

  basePrice Int

  participantUnit  Int @default(100)
  participantPrice Int @default(0)

  viewUnit  Int @default(1000)
  viewPrice Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("advertisement_pricing")
}

model AdvertisementMetric {
  id String @id @default(cuid())

  advertisementOrderId String

  type AdvertisementMetricType

  value Int @default(1)

  ipHash String?
  userId String?

  createdAt DateTime @default(now())

  advertisementOrder AdvertisementOrder @relation(fields: [advertisementOrderId], references: [id], onDelete: Cascade)

  @@index([advertisementOrderId])
  @@index([type])
  @@index([createdAt])
  @@index([userId])
  @@map("advertisement_metrics")
}

model ContestSourceVisit {
  id String @id @default(cuid())

  userId String?
  username String

  contestId String?
  contestTitle String
  contestLanguage String
  contestStartsAt DateTime?

  clueId String?
  clueSequence Int

  sourceUrl String
  sourceHostname String

  // Opaque correlation ID for a future advertiser-side click/landing integration.
  trackingToken String @unique @default(uuid())
  externalVerificationStatus ExternalVisitVerificationStatus @default(NOT_CONFIGURED)
  externalConfirmedAt DateTime?
  externalVerificationProvider String?
  externalReferenceId String?

  advertiserContentId String?
  advertiserContentTitle String?
  advertiserName String?
  advertisementOrderId String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  contest Contest? @relation(fields: [contestId], references: [id], onDelete: SetNull)
  clue ContestClue? @relation(fields: [clueId], references: [id], onDelete: SetNull)
  advertiserContent AdvertiserContent? @relation(fields: [advertiserContentId], references: [id], onDelete: SetNull)
  advertisementOrder AdvertisementOrder? @relation(fields: [advertisementOrderId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([contestId, clueSequence])
  @@index([userId, createdAt])
  @@index([sourceHostname, createdAt])
  @@index([advertisementOrderId, createdAt])
  @@index([externalVerificationStatus, createdAt])
  @@index([externalVerificationProvider, createdAt])
  @@unique([userId, clueId])
  @@map("contest_source_visits")
}


enum PrizeLedgerType {
  ROLLOVER_IN
  ROLLOVER_OUT
  AWARD
  PROJECT_PROFIT
  GLOBAL_ALLOCATION
}

model PrizePool {
  id String @id @default(cuid())
  contestId String @unique
  currency String @default("USDT")
  seededMicro BigInt @default(0)
  rolloverInMicro BigInt @default(0)
  rolloverOutMicro BigInt @default(0)
  awardedMicro BigInt @default(0)
  projectProfitMicro BigInt @default(0)
  returnedToGlobalMicro BigInt @default(0)
  testOnly Boolean @default(false)
  status String @default("OPEN")
  settledAt DateTime?
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("prize_pools")
}

model PrizeLedger {
  id String @id @default(cuid())
  contestId String
  type PrizeLedgerType
  amountMicro BigInt
  note String
  referenceKey String? @unique
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([contestId, type])
  @@map("prize_ledger")
}

model PrizeAward {
  id String @id @default(cuid())
  contestId String
  userId String
  username String
  rank Int
  amountMicro BigInt
  status String @default("PENDING_PAYMENT")
  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([contestId, userId])
  @@index([contestId, rank])
  @@map("prize_awards")
}

model WalletTransaction {
  id           String   @id @default(cuid())
  userId       String
  type         String
  status       String   @default("COMPLETED")
  amountMicro  BigInt
  currency     String   @default("USDT")
  note         String
  referenceKey String?  @unique
  contestId    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status, type])
  @@map("wallet_transactions")
}


enum GlobalPrizeLedgerType {
  TREASURY_FUNDING
  ROUND_ALLOCATION
  ROUND_UNUSED_RETURN
}

enum ProjectProfitLedgerType {
  CONTRIBUTION_SHARE
}

model GlobalPrizeFund {
  id String @id @default("global")
  balanceMicro BigInt @default(0)
  totalFundedMicro BigInt @default(0)
  totalAllocatedMicro BigInt @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("global_prize_funds")
}

model GlobalPrizeLedger {
  id String @id @default(cuid())
  type GlobalPrizeLedgerType
  amountMicro BigInt
  dayKey String? @unique
  contestId String?
  effectiveAt DateTime
  referenceKey String @unique
  note String
  createdAt DateTime @default(now())

  @@index([type, effectiveAt])
  @@index([contestId])
  @@map("global_prize_ledger")
}


model ProjectProfitFund {
  id String @id @default("project")
  balanceMicro BigInt @default(0)
  totalContributedMicro BigInt @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_profit_funds")
}

model ProjectProfitLedger {
  id String @id @default(cuid())
  type ProjectProfitLedgerType
  amountMicro BigInt
  effectiveAt DateTime
  referenceKey String @unique
  note String
  createdAt DateTime @default(now())

  @@index([type, effectiveAt])
  @@map("project_profit_ledger")
}


model AuthChallenge {
  id        String   @id @default(cuid())
  email     String
  purpose   String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
  @@map("auth_challenges")
}



enum WalletProvisioningStatus {
  CREATING
  COMPLETED
  REQUIRES_REVIEW
  FAILED
}

enum WalletNetworkFamily {
  EVM
  BITCOIN
  SOLANA
}

enum WalletAssetType {
  NATIVE
  TOKEN
}

enum WalletAssetVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REVIEW_REQUIRED
  REJECTED
}

enum WalletAddressType {
  EVM
  BITCOIN
  SOLANA
}

enum WalletLedgerEntryType {
  DEPOSIT_CREDIT
  DEPOSIT_REVERSAL
  WITHDRAWAL_RESERVE
  WITHDRAWAL_RELEASE
  WITHDRAWAL_SETTLEMENT
  NETWORK_FEE
  INTERNAL_TRANSFER
  MANUAL_ADJUSTMENT
}

enum WalletLedgerDirection {
  DEBIT
  CREDIT
}

enum WalletLedgerAccount {
  USER_AVAILABLE
  USER_RESERVED
  CUSTODY_ASSET
  EXTERNAL_COUNTERPARTY
  NETWORK_FEE_EXPENSE
  SYSTEM_CLEARING
}

enum WalletAccountStatus {
  ACTIVE
  SUSPENDED
}

enum WalletDepositStatus {
  DETECTED
  CONFIRMING
  CONFIRMED
  CREDITED
  REORGED
  IGNORED
}

enum WalletWithdrawalStatus {
  REQUESTED
  RESERVED
  APPROVED
  SIGNING
  BROADCAST
  CONFIRMED
  FAILED
  CANCELLED
}

model WalletAccount {
  id                         String @id @default(cuid())
  userId                     String @unique
  turnkeyOrganizationId      String? @unique
  turnkeyWalletId            String?
  turnkeyAccountId           String?
  turnkeyApiPublicKey        String?
  turnkeyApiPrivateKeyEncrypted String? @db.Text
  legacyTurnkeyWalletId      String?
  legacyAddress              String?
  address                    String @unique
  derivationPath             String?
  status                     WalletAccountStatus @default(ACTIVE)
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  networkAccounts   WalletNetworkAccount[]
  walletAddresses WalletAddress[]
  chainDeposits WalletChainDeposit[]
  chainWithdrawals WalletChainWithdrawal[]
  deposits          WalletDeposit[]
  withdrawals       WalletWithdrawal[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@map("wallet_accounts")
}

model WalletNetworkAccount {
  id              String @id @default(cuid())
  walletAccountId String
  chainId         Int
  networkKey      String
  depositEnabled  Boolean @default(false)
  withdrawalEnabled Boolean @default(false)
  walletAccount   WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  deposits        WalletDeposit[]
  withdrawals     WalletWithdrawal[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([walletAccountId, chainId])
  @@index([chainId, depositEnabled])
  @@map("wallet_network_accounts")
}

model ChainAsset {
  id                String @id @default(cuid())
  chainId           Int
  contractAddress   String
  symbol            String
  displayName       String
  decimals          Int
  issuerClassification String
  canonicalStatus   String @default("PENDING_VERIFICATION")
  depositEnabled    Boolean @default(false)
  withdrawalEnabled Boolean @default(false)
  deposits          WalletDeposit[]
  withdrawals       WalletWithdrawal[]
  treasuryDeposits  TreasuryDeposit[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([chainId, contractAddress])
  @@index([chainId, depositEnabled])
  @@map("chain_assets")
}

model WalletDeposit {
  id                   String @id @default(cuid())
  userId               String
  walletAccountId      String
  walletNetworkAccountId String
  chainAssetId         String
  chainId              Int
  transactionHash      String
  logIndex             Int
  blockNumber          BigInt
  blockHash            String
  fromAddress          String
  toAddress            String
  rawAmount            String
  amountMicro          BigInt?
  status               WalletDepositStatus @default(DETECTED)
  confirmationCount    Int @default(0)
  creditedLedgerId     String? @unique
  detectedAt           DateTime @default(now())
  confirmedAt          DateTime?
  creditedAt           DateTime?
  updatedAt            DateTime @updatedAt
  user                 User @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletAccount        WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)
  networkAccount       WalletNetworkAccount @relation(fields: [walletNetworkAccountId], references: [id], onDelete: Restrict)
  asset                ChainAsset @relation(fields: [chainAssetId], references: [id], onDelete: Restrict)
  @@unique([chainId, transactionHash, logIndex])
  @@index([userId, status, detectedAt])
  @@index([chainId, blockNumber])
  @@map("wallet_deposits")
}

model WalletWithdrawal {
  id                    String @id @default(cuid())
  userId                String
  walletAccountId       String
  walletNetworkAccountId String
  chainAssetId          String
  chainId               Int
  destinationAddress    String
  amountMicro           BigInt
  feeMicro              BigInt @default(0)
  status                WalletWithdrawalStatus @default(REQUESTED)
  idempotencyKey        String @unique
  turnkeyActivityId     String?
  transactionHash       String? @unique
  failureCode           String?
  requestedAt           DateTime @default(now())
  broadcastAt           DateTime?
  confirmedAt           DateTime?
  updatedAt             DateTime @updatedAt
  user                  User @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletAccount         WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)
  networkAccount        WalletNetworkAccount @relation(fields: [walletNetworkAccountId], references: [id], onDelete: Restrict)
  asset                 ChainAsset @relation(fields: [chainAssetId], references: [id], onDelete: Restrict)
  @@index([userId, status, requestedAt])
  @@index([chainId, status])
  @@map("wallet_withdrawals")
}

model TreasuryWallet {
  id              String   @id
  turnkeyWalletId String?  @unique
  address         String?  @unique
  chainId         Int      @default(137)
  networkKey      String   @default("polygon")
  status          String   @default("CREATING")
  deposits        TreasuryDeposit[]
  ledgerEntries   TreasuryLedger[]
  reconciliations TreasuryReconciliation[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@map("treasury_wallets")
}

// Treasury deposits are deliberately separate from user WalletDeposit records.
model TreasuryDeposit {
  id                String @id @default(cuid())
  treasuryWalletId  String
  chainAssetId      String
  chainId           Int
  transactionHash   String
  logIndex          Int
  blockNumber       BigInt
  blockHash         String
  fromAddress       String
  toAddress         String
  rawAmount         String
  amountMicro       BigInt?
  status            WalletDepositStatus @default(DETECTED)
  confirmationCount Int @default(0)
  detectedAt        DateTime @default(now())
  confirmedAt       DateTime?
  creditedAt        DateTime?
  updatedAt         DateTime @updatedAt

  treasuryWallet TreasuryWallet @relation(fields: [treasuryWalletId], references: [id], onDelete: Restrict)
  asset          ChainAsset     @relation(fields: [chainAssetId], references: [id], onDelete: Restrict)
  ledgerEntries  TreasuryLedger[]

  @@unique([chainId, transactionHash, logIndex])
  @@index([treasuryWalletId, status, detectedAt])
  @@index([chainId, blockNumber])
  @@map("treasury_deposits")
}

enum TreasuryLedgerType {
  DEPOSIT_CREDIT
  DEPOSIT_REVERSAL
  WITHDRAWAL_DEBIT
  WITHDRAWAL_REVERSAL
  GAS_EXPENSE
  MANUAL_ADJUSTMENT
}

// amountMicro is signed: positive values increase treasury accounting balance;
// negative values decrease it. Every entry has a unique idempotency reference.
model TreasuryLedger {
  id               String @id @default(cuid())
  treasuryWalletId String
  depositId        String?
  type             TreasuryLedgerType
  amountMicro      BigInt
  currency         String @default("USDT0")
  transactionHash  String?
  referenceKey     String @unique
  note             String
  effectiveAt      DateTime
  createdAt        DateTime @default(now())

  treasuryWallet TreasuryWallet  @relation(fields: [treasuryWalletId], references: [id], onDelete: Restrict)
  deposit        TreasuryDeposit? @relation(fields: [depositId], references: [id], onDelete: Restrict)

  @@index([treasuryWalletId, effectiveAt])
  @@index([type, effectiveAt])
  @@index([depositId])
  @@map("treasury_ledger")
}

model ChainScanCursor {
  chainId          Int @id
  lastBlockNumber  BigInt @default(0)
  lastBlockHash    String?
  updatedAt        DateTime @updatedAt
  @@map("chain_scan_cursors")
}


// Immutable snapshots comparing the Polygon USDT0 balance with the treasury ledger.
model TreasuryReconciliation {
  id                    String @id @default(cuid())
  treasuryWalletId      String
  chainId               Int
  asset                 String @default("USDT0")
  blockNumber           BigInt
  blockHash             String
  onChainBalanceMicro   BigInt
  ledgerBalanceMicro    BigInt
  differenceMicro      BigInt
  status                String
  createdAt             DateTime @default(now())

  treasuryWallet TreasuryWallet @relation(fields: [treasuryWalletId], references: [id], onDelete: Restrict)

  @@index([treasuryWalletId, createdAt])
  @@index([status, createdAt])
  @@map("treasury_reconciliations")
}


/// Stable chain identity. EVM networks use CAIP-2 IDs such as eip155:137.
/// Bitcoin and Solana use their own namespace rather than fake EVM chain IDs.
model WalletNetwork {
  id                         String @id
  family                     WalletNetworkFamily
  chainId                    Int? @unique
  networkKey                 String @unique
  displayName                String
  nativeAssetSymbol          String
  nativeAssetDecimals        Int
  explorerTransactionUrlTemplate String?
  finalityDepth              Int @default(1)
  isTestnet                  Boolean @default(false)
  isEnabled                  Boolean @default(false)
  depositEnabled             Boolean @default(false)
  withdrawalEnabled          Boolean @default(false)
  assets                     WalletAsset[]
  addresses                  WalletAddress[]
  deposits                   WalletChainDeposit[]
  withdrawals                WalletChainWithdrawal[]
  journals                   WalletJournal[]
  scanCursor                 WalletNetworkScanCursor?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  @@index([family, isEnabled])
  @@map("wallet_networks")
}

/// An asset is scoped to exactly one network. assetReference is "native" for
/// native currency or a normalized standard+contract/program identifier.
model WalletAsset {
  id                         String @id
  networkId                  String
  assetType                  WalletAssetType
  assetReference             String
  contractAddress            String?
  symbol                     String
  displayName                String
  decimals                   Int
  issuerClassification       String
  verificationStatus         WalletAssetVerificationStatus @default(PENDING_VERIFICATION)
  minDepositAtomic           Decimal? @db.Decimal(78, 0)
  confirmationCount          Int @default(1)
  depositEnabled             Boolean @default(false)
  withdrawalEnabled          Boolean @default(false)
  network                    WalletNetwork @relation(fields: [networkId], references: [id], onDelete: Restrict)
  deposits                   WalletChainDeposit[]
  withdrawals                WalletChainWithdrawal[] @relation("WithdrawalAsset")
  feeForWithdrawals          WalletChainWithdrawal[] @relation("WithdrawalFeeAsset")
  journals                   WalletJournal[]
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  @@unique([networkId, assetReference])
  @@index([networkId, depositEnabled])
  @@index([networkId, withdrawalEnabled])
  @@map("wallet_assets")
}

/// Network-specific public receiving/spending addresses. One EVM address can
/// be registered on compatible EVM networks; Bitcoin/Solana use their own type.
model WalletAddress {
  id                         String @id @default(cuid())
  walletAccountId            String
  networkId                  String
  address                    String
  addressType                WalletAddressType
  curve                      String?
  derivationPath             String?
  providerAccountId          String?
  isPrimary                  Boolean @default(true)
  status                     String @default("ACTIVE")
  walletAccount              WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)
  network                    WalletNetwork @relation(fields: [networkId], references: [id], onDelete: Restrict)
  deposits                   WalletChainDeposit[]
  withdrawals                WalletChainWithdrawal[]
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  @@unique([walletAccountId, networkId])
  @@unique([networkId, address])
  @@index([walletAccountId, status])
  @@map("wallet_addresses")
}

/// Generic deposit record, independent of EVM block/log field assumptions.
/// position can represent a block height, slot, or another chain-native position.
model WalletChainDeposit {
  id                         String @id @default(cuid())
  userId                     String
  walletAccountId            String
  walletAddressId            String
  networkId                  String
  walletAssetId              String
  transactionReference       String
  eventIndex                 Int @default(0)
  position                   String
  positionValue              Decimal @db.Decimal(78, 0)
  blockHash                  String?
  fromAddress                String?
  toAddress                  String
  rawAmount                  String
  amountAtomic               Decimal @db.Decimal(78, 0)
  reviewReason               String?
  status                     WalletDepositStatus @default(DETECTED)
  confirmationCount          Int @default(0)
  creditedJournalId          String? @unique
  detectedAt                 DateTime @default(now())
  confirmedAt                DateTime?
  creditedAt                 DateTime?
  updatedAt                  DateTime @updatedAt
  user                       User @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletAccount              WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)
  walletAddress              WalletAddress @relation(fields: [walletAddressId], references: [id], onDelete: Restrict)
  network                    WalletNetwork @relation(fields: [networkId], references: [id], onDelete: Restrict)
  asset                      WalletAsset @relation(fields: [walletAssetId], references: [id], onDelete: Restrict)
  @@unique([networkId, transactionReference, eventIndex])
  @@index([userId, status, detectedAt])
  @@index([networkId, position])
  @@map("wallet_chain_deposits")
}

/// Generic withdrawal record with an explicitly separate fee asset dimension.
model WalletChainWithdrawal {
  id                         String @id @default(cuid())
  userId                     String
  walletAccountId            String
  walletAddressId            String
  networkId                  String
  walletAssetId              String
  feeAssetId                 String?
  destinationAddress         String
  amountAtomic               Decimal @db.Decimal(78, 0)
  feeAtomic                  Decimal? @db.Decimal(78, 0)
  status                     WalletWithdrawalStatus @default(REQUESTED)
  idempotencyKey             String @unique
  signerActivityId           String?
  transactionReference       String? @unique
  failureCode                String?
  reviewedByUserId           String?
  reviewedAt                 DateTime?
  reviewReason               String?
  estimatedGasLimit          Decimal? @db.Decimal(78, 0)
  maxFeePerGasAtomic         Decimal? @db.Decimal(78, 0)
  actualFeeAtomic            Decimal? @db.Decimal(78, 0)
  blockPosition              String?
  blockHash                  String?
  confirmationCount          Int @default(0)
  lastCheckedAt              DateTime?
  requestedAt                DateTime @default(now())
  broadcastAt                DateTime?
  confirmedAt                DateTime?
  updatedAt                  DateTime @updatedAt
  user                       User @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletAccount              WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)
  walletAddress              WalletAddress @relation(fields: [walletAddressId], references: [id], onDelete: Restrict)
  network                    WalletNetwork @relation(fields: [networkId], references: [id], onDelete: Restrict)
  asset                      WalletAsset @relation("WithdrawalAsset", fields: [walletAssetId], references: [id], onDelete: Restrict)
  feeAsset                   WalletAsset? @relation("WithdrawalFeeAsset", fields: [feeAssetId], references: [id], onDelete: Restrict)
  @@index([userId, status, requestedAt])
  @@index([networkId, status])
  @@map("wallet_chain_withdrawals")
}

/// Immutable journal header. Every posted journal must contain balanced debit
/// and credit postings for its single network+asset dimension; the posting
/// service must verify equality in one database transaction before commit.
model WalletJournal {
  id                         String @id @default(cuid())
  userId                     String?
  networkId                  String
  walletAssetId              String
  entryType                  WalletLedgerEntryType
  referenceKey               String @unique
  note                       String
  reversalOfId               String? @unique
  user                       User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  network                    WalletNetwork @relation(fields: [networkId], references: [id], onDelete: Restrict)
  asset                      WalletAsset @relation(fields: [walletAssetId], references: [id], onDelete: Restrict)
  postings                   WalletJournalPosting[]
  reversalOf                 WalletJournal? @relation("WalletJournalReversals", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals                  WalletJournal[] @relation("WalletJournalReversals")
  createdAt                  DateTime @default(now())
  @@index([userId, createdAt])
  @@index([networkId, walletAssetId, createdAt])
  @@map("wallet_journals")
}

model WalletJournalPosting {
  id                         String @id @default(cuid())
  journalId                  String
  account                    WalletLedgerAccount
  direction                  WalletLedgerDirection
  amountAtomic               Decimal @db.Decimal(78, 0)
  accountReference           String?
  journal                    WalletJournal @relation(fields: [journalId], references: [id], onDelete: Restrict)
  createdAt                  DateTime @default(now())
  @@index([journalId, account])
  @@map("wallet_journal_postings")
}

/// One durable scanner cursor per network. Cursor values remain strings so
/// slots/heights are not constrained to an EVM integer representation.
model WalletNetworkScanCursor {
  networkId                  String @id
  cursorPosition             String @default("0")
  cursorHash                 String?
  leaseOwner                 String?
  leaseExpiresAt             DateTime?
  heartbeatAt                DateTime?
  network                    WalletNetwork @relation(fields: [networkId], references: [id], onDelete: Restrict)
  updatedAt                  DateTime @updatedAt
  @@map("wallet_network_scan_cursors")
}


/// Durable intent prevents duplicate external Turnkey Sub-Organization creation
/// when a remote request or database commit has an uncertain outcome.
model WalletProvisioningIntent {
  id                         String @id @default(cuid())
  userId                     String @unique
  idempotencyKey             String @unique
  status                     WalletProvisioningStatus @default(CREATING)
  turnkeyApiPublicKey        String
  turnkeyApiPrivateKeyEncrypted String @db.Text
  turnkeyOrganizationId      String? @unique
  turnkeyWalletId            String? @unique
  address                    String?
  failureCode                String?
  attemptCount               Int @default(1)
  completedAt                DateTime?
  user                       User @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  @@index([status, createdAt])
  @@map("wallet_provisioning_intents")
}
