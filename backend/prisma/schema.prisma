generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  ADVERTISER
}

enum ContestStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  FINISHED
  CANCELLED
}

enum ClueType {
  TEXT
  IMAGE
  PDF
  AUDIO
  VIDEO
  WEB_PAGE
}

enum ClueSource {
  SYSTEM
  ADVERTISER
}

enum AdvertiserContentType {
  TEXT
  LINK
  FILE
  IMAGE
  PDF
  AUDIO
  VIDEO
}

enum ContentProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  username     String @unique
  passwordHash String

  role UserRole @default(USER)

  submissions       Submission[]
  advertiserContent AdvertiserContent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}

model Contest {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      ContestStatus @default(DRAFT)

  startsAt DateTime?
  endsAt   DateTime?

  clues       ContestClue[]
  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startsAt])
  @@map("contests")
}

model AdvertiserContent {
  id String @id @default(cuid())

  advertiserId String

  type AdvertiserContentType

  title       String?
  description String?

  url      String?
  fileName String?
  filePath String?
  mimeType String?

  textContent String?

  processingStatus ContentProcessingStatus @default(PENDING)
  processingError  String?

  processedAt DateTime?

  advertiser User @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  clues ContestClue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advertiserId])
  @@index([processingStatus])
  @@map("advertiser_contents")
}

model ContestClue {
  id        String @id @default(cuid())
  contestId String
  sequence  Int

  type   ClueType   @default(TEXT)
  source ClueSource @default(SYSTEM)

  content String

  correctAnswer String

  advertiserContentId String?

  publishedAt DateTime?

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  advertiserContent AdvertiserContent? @relation(fields: [advertiserContentId], references: [id], onDelete: SetNull)

  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contestId, sequence])
  @@index([contestId])
  @@index([publishedAt])
  @@index([source])
  @@index([advertiserContentId])
  @@map("contest_clues")
}

model Submission {
  id String @id @default(cuid())

  userId    String
  contestId String
  clueId    String

  answer    String
  isCorrect Boolean @default(false)

  submittedAt    DateTime @default(now())
  responseTimeMs BigInt?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  clue ContestClue @relation(fields: [clueId], references: [id], onDelete: Cascade)

  @@index([userId, contestId])
  @@index([contestId, clueId])
  @@index([contestId, userId])
  @@map("submissions")
}
