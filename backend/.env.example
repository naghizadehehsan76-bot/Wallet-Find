# PostgreSQL / Neon connection string. Replace all placeholders locally.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate a unique random value. Never use this placeholder in production.
JWT_SECRET="replace-with-a-long-random-secret"

# Comma-separated allowed browser origin(s) for production.
CORS_ORIGIN="http://localhost:5173"

PORT=3000
CONTEST_SCHEDULER_INTERVAL_MS=30000
